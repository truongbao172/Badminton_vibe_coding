// Cloudflare Workers config. Render keeps using render.yaml + server.js; nothing here affects it.
//   npx wrangler dev      run locally (http://localhost:8787)
//   npx wrangler deploy   publish to <name>.<account>.workers.dev
{
  "name": "badminton-play-fun",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",

  // Builds dist/web/ (page + Three.js + assets) before every dev / deploy, and again when these folders change.
  "build": {
    "command": "node build.js web",
    "watch_dir": ["src", "assets", "vendor"]
  },

  // Static files are served straight from Cloudflare; only /rooms and /ws (not files) reach the Worker.
  "assets": { "directory": "dist/web" },

  // One Durable Object holds the 5 courts and every WebSocket. SQLite-backed so it runs on the free plan.
  "durable_objects": {
    "bindings": [{ "name": "HALL", "class_name": "Hall" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hall"] }],

  // Logs (court joins/leaves) show up in the dashboard and in `npx wrangler tail`.
  "observability": { "enabled": true }
}
